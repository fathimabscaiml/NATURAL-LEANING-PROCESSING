   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "from sklearn.datasets import fetch_20newsgroups\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sklearn.neighbors import KNeighborsClassifier\n",
    "from sklearn.metrics import classification_report, accuracy_score\n",
    "import random\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Fix random seeds for reproducibility\n",
    "SEED = 42\n",
    "np.random.seed(SEED)\n",
    "random.seed(SEED)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "007d43cd-893f-46a9-8889-e5a1b083a2ab",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Number of documents: 3759\n",
      "Classes: ['alt.atheism', 'comp.graphics', 'sci.med', 'soc.religion.christian']\n"
     ]
    }
   ],
   "source": [
    "# Load a subset of categories to keep the example fast\n",
    "categories = ['alt.atheism', 'soc.religion.christian', 'comp.graphics', 'sci.med']\n",
    "newsgroups = fetch_20newsgroups(subset='all', categories=categories,\n",
    "                                shuffle=True, random_state=SEED,\n",
    "                                remove=('headers', 'footers', 'quotes'))\n",
    "\n",
    "X_raw = newsgroups.data          # raw text documents\n",
    "y = newsgroups.target            # integer labels\n",
    "target_names = newsgroups.target_names\n",
    "print(f\"Number of documents: {len(X_raw)}\")\n",
    "print(f\"Classes: {target_names}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "f512d6b4-08a9-4b8f-834b-6e72f7e20480",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Train size: 3007, Test size: 752\n"
     ]
    }
   ],
   "source": [
    "X_train_raw, X_test_raw, y_train, y_test = train_test_split(\n",
    "    X_raw, y, test_size=0.2, random_state=SEED, stratify=y)\n",
    "print(f\"Train size: {len(X_train_raw)}, Test size: {len(X_test_raw)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "3a370545-26c5-493d-a29d-e4a3066b93b9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Training feature shape: (3007, 5000)\n",
      "Test feature shape: (752, 5000)\n"
     ]
    }
   ],
   "source": [
    "vectorizer = TfidfVectorizer(stop_words='english',\n",
    "                             lowercase=True,\n",
    "                             ngram_range=(1, 2),   # unigrams + bigrams\n",
    "                             max_features=5000)    # limit dimensionality for speed\n",
    "\n",
    "X_train = vectorizer.fit_transform(X_train_raw)\n",
    "X_test  = vectorizer.transform(X_test_raw)\n",
    "\n",
    "print(f\"Training feature shape: {X_train.shape}\")\n",
    "print(f\"Test feature shape: {X_test.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "e3aa76db-05f9-4738-b5b1-621c7c6f23cc",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Best parameters: {'metric': 'cosine', 'n_neighbors': 9, 'weights': 'distance'}\n",
      "Best cross‑validated accuracy: 0.8224\n"
     ]
    }
   ],
   "source": [
    "from sklearn.model_selection import GridSearchCV\n",
    "\n",
    "param_grid = {'n_neighbors': [3, 5, 7, 9],\n",
    "              'weights': ['uniform', 'distance'],\n",
    "              'metric': ['cosine', 'euclidean']}\n",
    "\n",
    "knn = KNeighborsClassifier()\n",
    "grid = GridSearchCV(knn, param_grid, cv=3, scoring='accuracy', n_jobs=-1)\n",
    "grid.fit(X_train, y_train)\n",
    "\n",
    "print(\"Best parameters:\", grid.best_params_)\n",
    "print(f\"Best cross‑validated accuracy: {grid.best_score_:.4f}\")\n",
    "\n",
    "best_knn = grid.best_estimator_"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "ca060e32-fe09-4299-88b7-3c4a72464423",
