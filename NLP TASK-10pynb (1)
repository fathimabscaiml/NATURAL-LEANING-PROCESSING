     "text": [
      "Test accuracy: 0.8231\n",
      "\n",
      "Classification report:\n",
      "                        precision    recall  f1-score   support\n",
      "\n",
      "           alt.atheism       0.73      0.68      0.70       160\n",
      "         comp.graphics       0.88      0.91      0.90       195\n",
      "               sci.med       0.87      0.84      0.85       198\n",
      "soc.religion.christian       0.80      0.83      0.81       199\n",
      "\n",
      "              accuracy                           0.82       752\n",
